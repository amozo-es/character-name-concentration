# Example environment file for the generation pipelines.
# Copy to `.env` next to the scripts and fill in the values you need.
# Each model config (model*.json, reviewer_model.json) names the variable
# it uses in its "api_key" field; the loader reads that variable from the
# environment or from this file.

# ── Required ─────────────────────────────────────────────────────────────
# OpenRouter-hosted models (model.json, model2.json, model3.json,
# model_pilot.json, reviewer_model.json)
OPENROUTER_APIKEY=

# Local Ollama models (model-local.json). Ollama does not check the key:
# any non-empty string works.
OLLAMA_APIKEY=

# ── Optional: direct provider keys (only if you add configs that use them)
GOOGLE_APIKEY=
ZAI_APIKEY=
OPENAI_APIKEY=
NVIDIA_APIKEY=

# ── Optional: Langfuse run observability ─────────────────────────────────
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_ENABLED=false
